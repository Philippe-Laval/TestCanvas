@namespace TestCanvas.Components.Graph
@implements IAsyncDisposable
@inject IJSRuntime JS

<div class="@Class" style="@Style">
    <canvas @ref="_canvas" class="graph-canvas-surface"></canvas>
</div>

@code {
    private ElementReference _canvas;
    private readonly GraphCanvasBridge _bridge = new();

    private IJSObjectReference? _module;
    private DotNetObjectReference<GraphCanvasBridge>? _bridgeRef;
    private GraphDocument? _document;
    private bool _ready;

    /// <summary>Document piloté. Peut être remplacé à tout moment.</summary>
    [Parameter]
    public GraphDocument? Document { get; set; }

    /// <summary>Classes CSS appliquées au conteneur.</summary>
    [Parameter]
    public string? Class { get; set; }

    /// <summary>Styles inline du conteneur (dimensions, marges…).</summary>
    [Parameter]
    public string? Style { get; set; }

    /// <summary>Options de rendu et d'interaction envoyées au moteur JavaScript.</summary>
    [Parameter]
    public GraphCanvasOptions Options { get; set; } = new();

    /// <summary>Levé après qu'un nœud a été déplacé à la souris.</summary>
    [Parameter]
    public EventCallback<string> NodeMoved { get; set; }

    /// <summary>Levé à chaque changement de sélection (côté JS ou C#).</summary>
    [Parameter]
    public EventCallback<IReadOnlyList<string>> SelectionChanged { get; set; }

    /// <summary>
    /// Levé lorsqu'une arête est demandée (Ctrl+glisser depuis un nœud).
    /// Le troisième indicateur signale une boucle (source et cible identiques).
    /// </summary>
    [Parameter]
    public EventCallback<(string SourceId, string TargetId, bool IsLoop)> LinkRequested { get; set; }

    [Parameter]
    public EventCallback<string> NodeDoubleClicked { get; set; }

    [Parameter]
    public EventCallback<(double X, double Y)> CanvasDoubleClicked { get; set; }

    [Parameter]
    public EventCallback<GraphContextMenuEvent> ContextMenu { get; set; }

    /// <summary>Levé lorsqu'un clic a lieu hors du menu contextuel ouvert.</summary>
    [Parameter]
    public EventCallback ContextMenuDismissed { get; set; }

    [Parameter]
    public EventCallback<(string Key, bool Ctrl, bool Shift)> KeyDown { get; set; }

    /// <summary>Vue courante (translation + zoom) du canvas.</summary>
    public GraphCanvasView View { get; private set; } = new();

    /// <summary>Levé lorsque le canvas est prêt et a reçu le contenu initial.</summary>
    public event Action? Ready;

    /// <summary>Le canvas est-il initialisé côté navigateur ?</summary>
    public bool IsReady => _ready;

    protected override void OnParametersSet()
    {
        if (_document is not null && !ReferenceEquals(_document, Document))
        {
            _document.Changed -= OnDocumentChanged;
            _document.SelectionChanged -= OnDocumentSelectionChanged;
            _document = null;
        }

        _document ??= Document;

        if (_document is not null)
        {
            _document.Changed -= OnDocumentChanged;
            _document.SelectionChanged -= OnDocumentSelectionChanged;
            _document.Changed += OnDocumentChanged;
            _document.SelectionChanged += OnDocumentSelectionChanged;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/graph-canvas.js");

        _bridgeRef = DotNetObjectReference.Create(_bridge);
        _bridge.Canvas = this;

        await _module.InvokeVoidAsync("create", _canvas, _bridgeRef, Options.ToDictionary());
        _ready = true;

        PushFullGraph();

        if (_document is not null)
        {
            await PushSelectionAsync(_document, _canvas);
        }

        Ready?.Invoke();
    }

    /// <summary>True si l'élément canvas existe déjà dans le DOM.</summary>
    private bool HasCanvas => _canvas.Id is not null;

    private void OnDocumentChanged(object? sender, GraphChange change)
    {
        if (!_ready || _module is null || !HasCanvas)
        {
            return;
        }

        if (change.Kind == GraphChangeKind.Reset)
        {
            PushFullGraph();
            return;
        }

        // Envoi incrémental : un seul aller-retour par objet modifié.
        _ = _module.InvokeVoidAsync("applyChanges", _canvas, new[] { change });
    }

    /// <summary>
    /// Toute sélection du document — qu'elle vienne du canvas ou d'une méthode
    /// appelée par la page — est répliquée côté JS et notifiée à l'hôte.
    /// </summary>
    private async void OnDocumentSelectionChanged(object? sender, GraphSelectionChangedEventArgs e)
    {
        if (!_ready || _module is null || _document is null || !HasCanvas)
        {
            return;
        }

        await PushSelectionAsync(_document, _canvas);

        await SelectionChanged.InvokeAsync([.. e.Nodes.Select(n => n.Id)]);
    }

    /// <summary>Renvoie l'intégralité du document au canvas.</summary>
    public void PushFullGraph()
    {
        if (!_ready || _module is null || !HasCanvas)
        {
            return;
        }

        object payload = _document is null
            ? new { nodes = Array.Empty<GraphNode>(), edges = Array.Empty<GraphEdge>() }
            : new { nodes = _document.Nodes, edges = _document.Edges };

        _ = _module.InvokeVoidAsync("setGraph", _canvas, payload);
    }

    private async Task PushSelectionAsync(GraphDocument document, ElementReference canvas)
    {
        if (_module is null)
        {
            return;
        }

        await _module.InvokeVoidAsync(
            "setSelection",
            canvas,
            document.SelectedNodes.Select(n => n.Id).ToArray(),
            document.SelectedEdge?.Id);
    }

    /// <summary>Recharge le canvas depuis le document et resynchronise la sélection.</summary>
    public async Task ReloadAsync()
    {
        if (_module is not null && HasCanvas)
        {
            // Les options doivent suivre : elles pilotent entre autres la
            // création de boucles.
            await _module.InvokeVoidAsync("setOptions", _canvas, Options.ToDictionary());
        }

        PushFullGraph();

        if (Document is not null && HasCanvas)
        {
            await PushSelectionAsync(Document, _canvas);
        }

        StateHasChanged();
    }

    /// <summary>Recadre la vue sur l'ensemble des nœuds.</summary>
    public async Task<GraphCanvasView> FitToViewAsync(double padding = 60)
    {
        View = await InvokeAsync("fitToView", padding);
        StateHasChanged();
        return View;
    }

    /// <summary>Multiplie le zoom (facteur &lt; 1 pour dézoomer).</summary>
    public async Task<GraphCanvasView> ZoomByAsync(double factor = 1.2)
    {
        View = await InvokeAsync("zoomBy", factor);
        StateHasChanged();
        return View;
    }

    public async Task<GraphCanvasView> SetZoomAsync(double zoom)
    {
        View = await InvokeAsync("setZoom", zoom);
        StateHasChanged();
        return View;
    }

    public async Task<GraphCanvasView> ResetViewAsync()
    {
        View = await InvokeAsync("resetView");
        StateHasChanged();
        return View;
    }

    /// <summary>Centre la vue sur un nœud, avec un zoom optionnel.</summary>
    public async Task<GraphCanvasView> FocusNodeAsync(string nodeId, double? zoom = null)
    {
        View = await InvokeAsync("focusNode", nodeId, zoom);
        StateHasChanged();
        return View;
    }

    /// <summary>
    /// Convertit un point écran (relatif au canvas) en coordonnées du graphe.
    /// Utile pour insérer un nœud à l'endroit可視 indicated par l'utilisateur.
    /// </summary>
    public async Task<GraphPoint> ScreenToGraphAsync(double offsetX, double offsetY)
    {
        if (!_ready || _module is null || !HasCanvas)
        {
            return new GraphPoint(0, 0);
        }

        return await _module.InvokeAsync<GraphPoint>("screenToGraph", _canvas, offsetX, offsetY);
    }

    /// <summary>Centre du canvas expressed dans le repère du graphe.</summary>
    /// <summary>
    /// Recale un élément flottant (menu contextuel) à l'intérieur du canvas en
    /// mesurant sa taille réelle. À appeler après le rendu de l'élément, sinon
    /// sa taille vaut 0 et le placement est faux.
    /// </summary>
    public async Task<GraphPoint?> PlacePopupAsync(ElementReference popup, double x, double y)
    {
        if (!_ready || _module is null || !HasCanvas)
        {
            return null;
        }

        return await _module.InvokeAsync<GraphPoint?>("placePopup", _canvas, popup, x, y);
    }

    public async Task<GraphPoint> GetCenterAsync()
    {
        if (!_ready || _module is null || !HasCanvas)
        {
            return new GraphPoint(0, 0);
        }

        return await _module.InvokeAsync<GraphPoint>("getCenter", _canvas);
    }

    /// <summary>Position d'un nœud à l'écran (coordonnées absolues de la fenêtre).</summary>
    public async Task<GraphScreenPosition?> GetNodeScreenPositionAsync(string nodeId)
    {
        if (!_ready || _module is null || !HasCanvas)
        {
            return null;
        }

        return await _module.InvokeAsync<GraphScreenPosition?>("getNodeScreenPosition", _canvas, nodeId);
    }

    /// <summary>Force le recalcul de la taille du buffer d'affichage.</summary>
    public async Task RefreshSizeAsync()
    {
        if (!_ready || _module is null || !HasCanvas)
        {
            return;
        }

        await _module.InvokeVoidAsync("resize", _canvas);
    }

    /// <summary>Export du canvas sous forme d'URL de données.</summary>
    public async Task<string?> ExportPngAsync(string type = "image/png", double quality = 0.92)
    {
        if (!_ready || _module is null || !HasCanvas)
        {
            return null;
        }

        return await _module.InvokeAsync<string?>("toDataUrl", _canvas, type, quality);
    }

    /// <summary>Déclenche le téléchargement du canvas au format image.</summary>
    public async Task<bool> DownloadPngAsync(string fileName = "graphe.png")
    {
        if (!_ready || _module is null || !HasCanvas)
        {
            return false;
        }

        return await _module.InvokeAsync<bool>("downloadPng", _canvas, fileName);
    }

    private async Task<GraphCanvasView> InvokeAsync(string method, params object?[] args)
    {
        if (!_ready || _module is null || !HasCanvas)
        {
            return View;
        }

        return await _module.InvokeAsync<GraphCanvasView>(method, [.. new object?[] { _canvas }, .. args]);
    }

    // ------------------------------------------------- pont appelé par le JavaScript

    internal Task NotifyNodeMovedAsync(string nodeId, double x, double y, IReadOnlyList<string> moved)
    {
        if (_document is not { } document)
        {
            return NodeMoved.InvokeAsync(nodeId);
        }

        var leader = document.FindNode(nodeId);
        if (leader is null)
        {
            return NodeMoved.InvokeAsync(nodeId);
        }

        // Le décalage est calculé avant toute écriture : les nœuds doivent être lus
        // dans leur état d'origine.
        var deltaX = x - leader.X;
        var deltaY = y - leader.Y;

        // C# fait foi : la position remontée par le canvas est appliquée au
        // document, qui la diffuse ensuite à tous les abonnés.
        document.BeginBatch();
        try
        {
            document.MoveNode(nodeId, x, y);

            // Les nœuds déplacés en même temps reçoivent le même incrément.
            if (moved.Count > 1)
            {
                foreach (var id in moved)
                {
                    if (id != nodeId && document.FindNode(id) is { } node && !node.Locked)
                    {
                        node.MoveTo(node.X + deltaX, node.Y + deltaY);
                    }
                }
            }
        }
        finally
        {
            // Un seul envoi au canvas pour l'ensemble du groupe.
            document.EndBatch();
        }

        return NodeMoved.InvokeAsync(nodeId);
    }

    internal Task NotifySelectionChangedAsync(IReadOnlyList<string> nodeIds, string? edgeId)
    {
        // Le document notifie sa sélection, ce qui la répercute côté JS et auprès de
// l'hôte via SelectionChanged : inutile de le faire une seconde fois ici.
        if (_document is { } document)
        {
            document.SetSelection(nodeIds, edgeId);
        }

        return Task.CompletedTask;
    }

    internal Task NotifyLinkRequestedAsync(string sourceId, string targetId, bool isLoop)
        => LinkRequested.InvokeAsync((sourceId, targetId, isLoop));

    internal Task NotifyNodeDoubleClickedAsync(string nodeId)
        => NodeDoubleClicked.InvokeAsync(nodeId);

    internal Task NotifyCanvasDoubleClickedAsync(double x, double y)
        => CanvasDoubleClicked.InvokeAsync((x, y));

    internal Task NotifyContextMenuAsync(
        string? id, string kind, double x, double y, double offsetX, double offsetY)
        => ContextMenu.InvokeAsync(new GraphContextMenuEvent(id, kind, x, y, offsetX, offsetY));

    internal Task NotifyKeyDownAsync(string key, bool ctrl, bool shift)
        => KeyDown.InvokeAsync((key, ctrl, shift));

    internal Task NotifyContextMenuDismissedAsync()
        => ContextMenuDismissed.InvokeAsync();

    public async ValueTask DisposeAsync()
    {
        if (_document is not null)
        {
            _document.Changed -= OnDocumentChanged;
            _document.SelectionChanged -= OnDocumentSelectionChanged;
        }

        _bridgeRef?.Dispose();
        _bridge.Canvas = null;

        if (_module is not null)
        {
            try
            {
                if (HasCanvas)
                {
                    await _module.InvokeVoidAsync("dispose", _canvas);
                }

                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // Circuit Blazor déjà fermé.
            }
            catch (ObjectDisposedException)
            {
                // Idem.
            }
        }

        _ready = false;
    }
}