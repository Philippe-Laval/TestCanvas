    private void OnSelectionChanged(IReadOnlyList<string> nodeIds)
    {
        // Le document expose les nœuds dans l'ordre de sélection : le premier est
        // le nœud actif, celui que le canvas affiche avec un anneau plein.
        _selectedNode = _graph.PrimarySelectedNode;
        Log(_selectedNode is null
            ? "Sélection effacée"
            : _graph.SelectedNodes.Count > 1
                ? $"Sélection : {_selectedNode.Label} + {_graph.SelectedNodes.Count - 1} autre(s)"
                : $"Sélection : {_selectedNode.Label}");
    }

    /// <summary>
    /// Ctrl+glisser entre deux nœuds. Le multigraphe est autorisé : si une liaison
    /// existe déjà dans ce sens, on en ajoute une seconde plutôt que de refuser.
    /// </summary>
    private void OnLinkRequested((string SourceId, string TargetId, bool IsLoop) link)
    {
        Track();

        var source = _graph.FindNode(link.SourceId);
        var target = _graph.FindNode(link.TargetId);
        if (source is null || target is null)
        {
            return;
        }

        if (link.IsLoop && !_graph.AllowSelfLoops)
        {
            Log("Boucle refusée : activez « Boucles » pour autoriser le pseudographe");
            return;
        }

        var existing = _graph.Edges
            .Count(e => e.SourceId == link.SourceId && e.TargetId == link.TargetId);

        var edge = _graph.AddEdge(link.SourceId, link.TargetId);

        if (link.IsLoop)
        {
            _graph.SelectEdge(edge.Id);
            Log(existing > 0
                ? $"Boucle n°{existing + 1} sur {source.Label} (degré {(_graph.Degree(source.Id))})"
                : $"Boucle créée sur {source.Label} (degré {(_graph.Degree(source.Id))})");
            return;
        }

        Log(existing > 0
            ? $"Liaison parallèle n°{existing + 1} : {source.Label} → {target.Label}"
            : $"Liaison {source.Label} → {target.Label}");
    }

