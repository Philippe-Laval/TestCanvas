    /// <summary>
    /// Calcule le plus court chemin et met en avant le résultat (purement côté C#).
    /// Les extrémités sont les deux nœuds sélectionnés : le nœud primaire en
    /// départ, le suivant en arrivée. Sans sélection multiple, on retombe sur le
    /// premier nœud du document distinct du nœud sélectionné.
    /// </summary>
    private void HighlightShortestPath()
    {
        var selected = _graph.SelectedNodes;

        var from = selected.Count > 0 ? selected[0] : _graph.Nodes.FirstOrDefault();
        if (from is null)
        {
            return;
        }

        var to = selected.Count > 1
            ? selected[1]
            : _graph.Nodes.FirstOrDefault(n => n.Id != from.Id);

        if (to is null || to.Id == from.Id)
        {
            Log("Sélectionnez deux nœuds distincts pour calculer un chemin");
            return;
        }

        var path = GraphAlgorithms.ShortestPath(_graph, from.Id, to.Id);
        if (path is null || path.Count < 2)
        {
            _graph.ClearHighlight();
            Log($"Aucun chemin entre {from.Label} et {to.Label}");
            return;
        }

        var nodeIds = path.Select(n => n.Id).ToList();
        var edgeIds = new List<string>();

        for (var i = 0; i < path.Count - 1; i++)
        {
            edgeIds.AddRange(
                _graph.Edges
                    .Where(e =>
                        (e.SourceId == path[i].Id && e.TargetId == path[i + 1].Id)
                        || (e.SourceId == path[i + 1].Id && e.TargetId == path[i].Id))
                    .Select(e => e.Id));
        }

        _graph.SetHighlight(nodeIds, edgeIds);
        Log($"Chemin {from.Label} → {to.Label} : {string.Join(" → ", path.Select(n => n.Label))} ({edgeIds.Count} arêtes)");
    }

    private void ClearHighlight() => _graph.ClearHighlight();

