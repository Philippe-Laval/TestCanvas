    private void OnKeyDown((string Key, bool Ctrl, bool Shift) key)
    {
        if (key.Key == "Escape")
        {
            // Ferme les deux menus flottants sans rien modifier d'autre.
            CloseContextMenu();
            CloseLayoutMenu();
            return;
        }

        if (key.Key is not ("Delete" or "Backspace" or "F2"))
        {
            return;
        }

        if (key.Key == "F2" && _selectedNode is { } rename)
        {
            rename.Label = $"{rename.Label} (v2)";
            Log("Raccourci F2 appliqué");
            return;
        }

        DeleteSelection();
    }

