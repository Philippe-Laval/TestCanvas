    /// <summary>Crée une boucle sur un nœud (pseudographe).</summary>
    private void ContextAddLoop(GraphNode node)
    {
        if (!_graph.AllowSelfLoops)
        {
            return;
        }

        Track();
        var count = _graph.LoopsOf(node.Id).Count;
        var loop = _graph.AddEdge(node.Id, node.Id);
        loop.Color = EdgePalette[(count + EdgePalette.Length - 1) % EdgePalette.Length];
        _graph.SelectEdge(loop.Id);

        Log($"Boucle n°{count + 1} sur {node.Label} — degré {_graph.Degree(node.Id)}");
        CloseContextMenu();
    }

    private void ContextReverseEdge(GraphEdge edge)
    {
