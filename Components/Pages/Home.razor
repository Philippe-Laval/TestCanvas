        {
            edge.Color = color;
        }
    }

    private void UpdateEdgeWidth(GraphEdge edge, string? value) => edge.Width = Parse(value, edge.Width);

    /// <summary>Duplique une liaison entre les mêmes deux nœuds (multigraphe).</summary>
    private void AddParallelEdge(GraphEdge edge)
    {
        Track();
        var count = _graph.ParallelCount(edge);
        var created = _graph.AddEdge(edge.SourceId, edge.TargetId, string.Empty);

        created.Type = edge.Type;
        created.Color = EdgePalette[(count - 1 + EdgePalette.Length) % EdgePalette.Length];
        _graph.SelectEdge(created.Id);

        Log($"Liaison parallèle créée ({count} au total) : {created.Id}");
    }

    private void DeleteEdge(GraphEdge edge)
    {
        Track();
        _graph.RemoveEdge(edge.Id);
        Log($"Liaison supprimée : {edge.Id}");
    }

    private void UpdateEdgeStyle(GraphEdge edge, string? style)
    {
        if (Enum.TryParse<EdgeStyle>(style, out var parsed))
        {
            edge.Style = parsed;
        }
    }

    private void ToggleEdgeDashed(GraphEdge edge, object? value) => edge.Dashed = value is true;

    private static double Parse(string? text, double fallback)
    {
        // Les champs <input type="number"> et "range" sont normalisés avec un point
        // décimal par le navigateur : le format invariant est donc prioritaire.
        return double.TryParse(text, System.Globalization.NumberStyles.Float,
                   System.Globalization.CultureInfo.InvariantCulture, out var value)
               ? value
               : double.TryParse(text, System.Globalization.NumberStyles.Float,
                   System.Globalization.CultureInfo.CurrentCulture, out var local)
                   ? local
                   : fallback;
    }

    /// <summary>
    /// Formatage des valeurs numériques destinées aux champs de formulaire.
    /// Le HTML exige un point décimal, quelle que soit la culture de l'interface :
    /// sans cela, « 15,48 » est rejeté et la saisie se fige.
    /// </summary>
    private static string Num(double value)
        => value.ToString("0.####", System.Globalization.CultureInfo.InvariantCulture);

    // ---------------------------------------------------------- sérialisation

    private void ExportJson() => _json = GraphSerializer.Serialize(_graph);

    private async Task ImportJson()
    {
        if (string.IsNullOrWhiteSpace(_json))
        {
            Log("Aucun JSON à importer");
            return;
        }

        try
        {
            var imported = GraphSerializer.Deserialize(_json);
            _history.Track();
            _graph.Reset(imported.Nodes, imported.Edges);
            _selectedNode = null;
            Log($"Import réussi : {_graph.NodeCount} nœuds, {_graph.EdgeCount} arêtes");
            await FitViewAsync();
        }
        catch (FormatException ex)
        {
            Log($"Échec de l'import : {ex.Message}");
        }
    }

    private async Task DownloadPng()
    {
        var name = $"graphe-{DateTime.Now:yyyyMMdd-HHmm}.png";

        if (await _canvas.DownloadPngAsync(name))
        {
            Log($"Export PNG téléchargé ({name})");
        }
        else
        {
            Log("Export PNG indisponible");
        }
    }

    private void Log(string message)
    {
        _log.Insert(0, $"{DateTime.Now:HH:mm:ss} — {message}");
        if (_log.Count > 12)
        {
            _log.RemoveAt(_log.Count - 1);
        }
    }
