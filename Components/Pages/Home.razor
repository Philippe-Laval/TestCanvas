@page "/"
@rendermode InteractiveServer
@using TestCanvas.Models
@using TestCanvas.Services
@using TestCanvas.Components.Graph
@implements IDisposable

<PageTitle>Canvas de graphe</PageTitle>

<div class="page">
    <header class="page-header">
        <h1>Graphe interactif</h1>
        <p class="subtitle">
            Canvas JavaScript piloté par un <code>GraphDocument</code> C#. Déplacez les nœuds à la
            souris&nbsp;: les modifications remontent dans le modèle Blazor, qui reste la source de vérité.
        </p>
    </header>

    <div class="toolbar">
        <button class="btn primary" @onclick="AddNode">Ajouter un nœud</button>
        <button class="btn" @onclick="AddNodeAtCenter">Ajouter au centre</button>
        <button class="btn" @onclick="AddLinkedPair">Ajouter une paire liée</button>
        <div class="menu-anchor">
            <button class="btn primary-outline @(_layoutMenuOpen ? "open" : null)"
                    @onclick="ToggleLayoutMenu"
                    disabled="@(_graph.NodeCount == 0)"
                    title="Choisir un algorithme de disposition des nœuds">
                Disposition <span class="caret">▾</span>
            </button>

            @if (_layoutMenuOpen)
            {
                <div class="popup" @onclick:stopPropagation="true">
                    <div class="popup-head">
                        <span>Algorithmes de disposition</span>
                        <button class="popup-close" @onclick="CloseLayoutMenu" title="Fermer">×</button>
                    </div>

                    @foreach (var family in Enum.GetValues<LayoutFamily>())
                    {
                        var items = LayoutAlgorithms.All.Where(d => d.Family == family).ToList();
                        if (items.Count == 0)
                        {
                            continue;
                        }

                        <div class="popup-group" title="@LayoutAlgorithms.Describe(family)">
                            @LayoutAlgorithms.FamilyLabel(family)
                        </div>

                        @foreach (var descriptor in items)
                        {
                            <button class="popup-item @(descriptor.Algorithm == _lastLayout ? "active" : null)"
                                    disabled="@(_graph.NodeCount == 0)"
                                    @onclick="() => ApplyLayout(descriptor)">
                                <span class="popup-name">@descriptor.Name</span>
                                <span class="popup-summary">@descriptor.Summary</span>
                            </button>
                        }
                    }

                    <div class="popup-params">
                        <label>
                            Espacement <span class="param-value">@((int)_layoutOptions.Spacing)</span>
                            <input type="range" min="60" max="320" step="10"
                                   value="@Num(_layoutOptions.Spacing)"
                                   @onchange="e => SetSpacing(e.Value?.ToString())" />
                        </label>
                        <label>
                            Itérations <span class="param-value">@_layoutOptions.Iterations</span>
                            <input type="range" min="25" max="600" step="25"
                                   value="@_layoutOptions.Iterations"
                                   @onchange="e => SetIterations(e.Value?.ToString())" />
                        </label>
                        <button class="popup-rerun" @onclick="() => ApplyLayout(LayoutAlgorithms.Get(_lastLayout))"
                                disabled="@(_graph.NodeCount == 0)">
                            Relancer « @LayoutAlgorithms.Get(_lastLayout).Name »
                        </button>
                    </div>
                </div>

                <div class="popup-backdrop" @onclick="CloseLayoutMenu"></div>
            }
        </div>
        <span class="separator"></span>
        <button class="btn" @onclick="HighlightShortestPath" disabled="@(_graph.NodeCount < 2)" title="Calcul du plus court chemin en C#, nœuds et arêtes mis en avant">
            Chemin le plus court
        </button>
        <button class="btn" @onclick="ClearHighlight" disabled="@(_graph.HighlightedNodeIds.Count == 0)">Effacer la surbrillance</button>
        <span class="separator"></span>
        <button class="btn" @onclick="DeleteSelection" disabled="@(_graph.SelectedNodes.Count == 0 && _graph.SelectedEdge is null)">Supprimer la sélection</button>
        <button class="btn" @onclick="SelectAll" disabled="@(_graph.NodeCount == 0)">Sélectionner tout</button>
        <button class="btn danger" @onclick="ClearGraph" disabled="@(_graph.NodeCount == 0)">Vider</button>
        <button class="btn" @onclick="Undo" disabled="@(!_history.CanUndo)" title="Annuler (instantané C#)">↶</button>
        <button class="btn" @onclick="Redo" disabled="@(!_history.CanRedo)" title="Rétablir">↷</button>
        <span class="separator"></span>
        <label class="toggle">
            <input type="checkbox" checked="@_snapToGrid" @onchange="OnSnapChanged" />
            Magnétisme grille
        </label>
        <label class="toggle">
            <input type="checkbox" checked="@_showGrid" @onchange="OnGridChanged" />
            Grille
        </label>
        <label class="toggle" title="Autorise les arêtes d'un nœud à lui-même (pseudographe)">
            <input type="checkbox" checked="@_graph.AllowSelfLoops" @onchange="OnSelfLoopsChanged" />
            Boucles
        </label>
        <span class="separator"></span>
        <button class="btn" @onclick="ZoomIn" title="Zoom avant">+</button>
        <button class="btn" @onclick="ZoomOut" title="Zoom arrière">&minus;</button>
        <button class="btn" @onclick="FitView" title="Recadrer sur le graphe">Recadrer</button>
        <span class="zoom-readout">@_zoomText</span>
    </div>

    <div class="workspace">
        <div class="canvas-pane">
            <GraphCanvas @ref="_canvas"
                         Document="_graph"
                         Class="canvas-host"
                         Options="_options"
                         NodeMoved="OnNodeMoved"
                         SelectionChanged="OnSelectionChanged"
                         LinkRequested="OnLinkRequested"
                         CanvasDoubleClicked="OnCanvasDoubleClicked"
                         NodeDoubleClicked="OnNodeDoubleClicked"
                         ContextMenu="OnContextMenu"
                         ContextMenuDismissed="OnContextMenuDismissed"
                         KeyDown="OnKeyDown" />

            <div class="hud">
                <div><strong>@_graph.NodeCount</strong> nœuds &middot; <strong>@_graph.EdgeCount</strong> arêtes</div>
                <div class="hint">
                    Glisser&nbsp;: déplacer &middot; Molette&nbsp;: zoom &middot; Clic droit&nbsp;: menu &middot;
                    Ctrl+glisser depuis un nœud&nbsp;: créer un lien &middot; Maj+glisser&nbsp;: sélection rectangulaire
                </div>
            </div>

            @if (_contextMenu is not null)
            {
                <div class="context-menu"
                     id="graph-context-menu"
                     @ref="_contextMenuRef"
                     @oncontextmenu:preventDefault="true">
                    @if (_contextMenu.Kind == "node" && _graph.FindNode(_contextMenu.Id) is { } target)
                    {
                        <div class="context-title">Nœud&nbsp;: @target.Label</div>
                        <button @onclick="() => ContextRenameNode(target)">Renommer…</button>
                        <button @onclick="() => ContextRandomizeColor(target)">Couleur aléatoire</button>
                        <button @onclick="() => ContextToggleLock(target)">@(target.Locked ? "Déverrouiller" : "Verrouiller")</button>
                        <button @onclick="() => ContextToggleShape(target)">Changer de forme</button>
                        @if (_graph.AllowSelfLoops)
                        {
                            <button @onclick="() => ContextAddLoop(target)">Ajouter une boucle</button>
                        }
                        <hr />
                        <button class="danger" @onclick="() => ContextDeleteNode(target)">Supprimer</button>
                    }
                    else if (_contextMenu.Kind == "edge" && _graph.FindEdge(_contextMenu.Id) is { } edge)
                    {
                        <div class="context-title">
                            Arête&nbsp;: @(_graph.FindNode(edge.SourceId)?.Label ?? edge.SourceId)
                            &rarr; @(_graph.FindNode(edge.TargetId)?.Label ?? edge.TargetId)
                        </div>
                        <button @onclick="() => ContextSetDirected(edge, true)">
                            @(edge.Directed ? "● " : "○ ")Orientée (flèche)
                        </button>
                        <button @onclick="() => ContextSetDirected(edge, false)">
                            @(!edge.Directed ? "● " : "○ ")Non orientée
                        </button>
                        <hr />
                        <button @onclick="() => ContextReverseEdge(edge)">Inverser le sens</button>
                        <button @onclick="() => ContextToggleEdgeStyle(edge)">Style&nbsp;: @edge.Style</button>
                        <button @onclick="() => ContextAddParallelEdge(edge)">
                            Ajouter une liaison parallèle
                        </button>
                        <hr />
                        <button class="danger" @onclick="() => ContextDeleteEdge(edge)">Supprimer</button>
                    }
                    else
                    {
                        <div class="context-title">Canvas (@((int)_contextMenu.X), @((int)_contextMenu.Y))</div>
                        <button @onclick="() => ContextAddNodeAt(_contextMenu.X, _contextMenu.Y)">Ajouter un nœud ici</button>
                        <button @onclick="ContextFitView">Recadrer la vue</button>
                    }
                </div>
            }
        </div>

        <aside class="side-panel">
            <section>
                <h2>Sélection</h2>
                @if (_selectedNode is { } node)
                {
                    <dl class="inspector">
                        <dt>Identifiant</dt>
                        <dd><code>@node.Id</code></dd>
                        <dt>Libellé</dt>
                        <dd><input class="input" value="@node.Label" @onchange="e => UpdateLabel(node, e.Value?.ToString() ?? string.Empty)" /></dd>
                        <dt>Forme</dt>
                        <dd>
                            <select class="input" value="@node.Shape" @onchange="e => UpdateShape(node, e.Value?.ToString())">
                                @foreach (var shape in Enum.GetValues<NodeShape>())
                                {
                                    <option value="@shape">@shape</option>
                                }
                            </select>
                        </dd>
                        <dt>Couleur</dt>
                        <dd><input type="color" class="input color" value="@node.Fill" @onchange="e => UpdateColor(node, e.Value?.ToString())" /></dd>
                        <dt>Position</dt>
                        <dd>
                            <input class="input tiny" type="number" step="1" value="@Num(node.X)"
                                   @onchange="e => UpdatePosition(node, e.Value?.ToString(), Num(node.Y))" />
                            <input class="input tiny" type="number" step="1" value="@Num(node.Y)"
                                   @onchange="e => UpdatePosition(node, Num(node.X), e.Value?.ToString())" />
                        </dd>
                        <dt>Rayon</dt>
                        <dd><input class="input" type="range" min="12" max="70" value="@Num(node.Radius)" @oninput="e => UpdateRadius(node, e.Value?.ToString())" /></dd>
                        <dt>Verrouillé</dt>
                        <dd><input type="checkbox" checked="@node.Locked" @onchange="e => ToggleLock(node, e.Value)" /></dd>
                        <dt>Degré</dt>
                        <dd class="degree">
                            <span title="Degré total (pseudographe : une boucle compte deux fois)">@_graph.Degree(node.Id)</span>
                            <span class="muted" title="Arêtes sortantes">→ @_graph.OutDegree(node.Id)</span>
                            <span class="muted" title="Arêtes entrantes">← @_graph.InDegree(node.Id)</span>
                        </dd>
                        @if (_graph.LoopsOf(node.Id).Count > 0)
                        {
                            <dt>Boucles</dt>
                            <dd class="degree">
                                @foreach (var loop in _graph.LoopsOf(node.Id))
                                {
                                    <button class="link-btn" title="Sélectionner la boucle @loop.Id"
                                            @onclick="() => _graph.SelectEdge(loop.Id)">@loop.Id</button>
                                }
                                @if (_graph.AllowSelfLoops)
                                {
                                    <button class="link-btn" title="Ajouter une boucle sur ce nœud"
                                            @onclick="() => ContextAddLoop(node)">+</button>
                                }
                            </dd>
                        }
                    </dl>
                }
                else if (_graph.SelectedEdge is { } selectedEdge)
                {
                    <dl class="inspector">
                        <dt>Identifiant</dt>
                        <dd><code>@selectedEdge.Id</code></dd>
                        <dt>Extrémités</dt>
                        <dd>
                            <span class="edge-ends">
                                @(_graph.FindNode(selectedEdge.SourceId)?.Label ?? selectedEdge.SourceId)
                                @if (selectedEdge.Directed)
                                {
                                    <span class="arrow">&rarr;</span>
                                }
                                else
                                {
                                    <span class="arrow">&ndash;</span>
                                }
                                @(_graph.FindNode(selectedEdge.TargetId)?.Label ?? selectedEdge.TargetId)
                            </span>
                            @if (_graph.ParallelCount(selectedEdge) > 1)
                            {
                                <span class="badge" title="Plusieurs liaisons entre ces deux nœuds">
                                    @_graph.ParallelCount(selectedEdge) liaisons parallèles
                                </span>
                            }
                        </dd>
                        <dt>Type</dt>
                        <dd>
                            <input class="input" list="edge-types" value="@selectedEdge.Type"
                                   @onchange="e => UpdateEdgeType(selectedEdge, e.Value?.ToString())" />
                            <datalist id="edge-types">
                                @foreach (var type in EdgeTypes)
                                {
                                    <option value="@type"></option>
                                }
                            </datalist>
                        </dd>
                        <dt>Libellé</dt>
                        <dd><input class="input" value="@selectedEdge.Label" @onchange="e => UpdateEdgeLabel(selectedEdge, e.Value?.ToString() ?? string.Empty)" /></dd>
                        <dt>Sens</dt>
                        <dd>
                            <div class="segmented" role="group" aria-label="Sens de la liaison">
                                <button class="@(selectedEdge.Directed ? "on" : null)"
                                        @onclick="() => SetEdgeDirected(selectedEdge, true)">Orientée</button>
                                <button class="@(!selectedEdge.Directed ? "on" : null)"
                                        @onclick="() => SetEdgeDirected(selectedEdge, false)">Non orientée</button>
                            </div>
                        </dd>
                        <dt>Couleur</dt>
                        <dd><input type="color" class="input color" value="@selectedEdge.Color" @onchange="e => UpdateEdgeColor(selectedEdge, e.Value?.ToString())" /></dd>
                        <dt>Épaisseur</dt>
                        <dd><input class="input" type="range" min="1" max="8" step="0.5" value="@Num(selectedEdge.Width)" @oninput="e => UpdateEdgeWidth(selectedEdge, e.Value?.ToString())" /></dd>
                        <dt>Style</dt>
                        <dd>
                            <select class="input" value="@selectedEdge.Style" @onchange="e => UpdateEdgeStyle(selectedEdge, e.Value?.ToString())">
                                @foreach (var style in Enum.GetValues<EdgeStyle>())
                                {
                                    <option value="@style">@style</option>
                                }
                            </select>
                        </dd>
                        <dt>Pointillés</dt>
                        <dd><input type="checkbox" checked="@selectedEdge.Dashed" @onchange="e => ToggleEdgeDashed(selectedEdge, e.Value)" /></dd>
                        <dt></dt>
                        <dd>
                            <div class="row">
                                <button class="btn" @onclick="() => AddParallelEdge(selectedEdge)">Liaison parallèle</button>
                                <button class="btn danger" @onclick="() => DeleteEdge(selectedEdge)">Supprimer</button>
                            </div>
                        </dd>
                    </dl>
                }
                else
                {
                    <p class="empty">Aucun élément sélectionné.</p>
                }
            </section>

            <section>
                <h2>Données</h2>
                <DataEditor Target="DataTarget"
                           Caption="@DataCaption"
                           OnTrack="TrackData"
                           OnNotify="Log" />
            </section>

            <section>
                <h2>Arêtes du nœud</h2>
                @if (_selectedNode is not null && _graph.EdgesOf(_selectedNode.Id).Count > 0)
                {
                    <ul class="edge-list">
                        @foreach (var edge in _graph.EdgesOf(_selectedNode.Id))
                        {
                            var other = edge.SourceId == _selectedNode.Id ? edge.TargetId : edge.SourceId;
                            <li>
                                <span>@(_graph.FindNode(other)?.Label ?? other)</span>
                                <button class="link-btn danger" @onclick="() => _graph.RemoveEdge(edge.Id)">×</button>
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <p class="empty">Aucune arête.</p>
                }
            </section>

            <section>
                <h2>Journal</h2>
                <ol class="log">
                    @foreach (var entry in _log)
                    {
                        <li>@entry</li>
                    }
                </ol>
            </section>

            <section>
                <h2>Sérialisation</h2>
                <div class="row">
                    <button class="btn" @onclick="ExportJson">Sérialiser</button>
                    <button class="btn" @onclick="ImportJson">Désérialiser</button>
                    <button class="btn" @onclick="DownloadPng">PNG</button>
                </div>
                <textarea class="json" readonly placeholder="Le JSON du graphe s'affichera ici.">@_json</textarea>
            </section>
        </aside>
    </div>
</div>

@code {
    private readonly GraphDocument _graph = new();
    private readonly GraphHistory _history = new();
    private readonly List<string> _log = [];

    private GraphCanvas _canvas = default!;
    private GraphCanvasOptions _options = new();
    private GraphNode? _selectedNode;
    private GraphContextMenuEvent? _contextMenu;
    private ElementReference _contextMenuRef;
    private bool _pendingMenuPlacement;
    private string _json = string.Empty;
    private bool _snapToGrid;
    private bool _showGrid = true;
    private int _renameCounter;
    private string _zoomText = "zoom 100%";
    private bool _layoutMenuOpen;
    private LayoutAlgorithm _lastLayout = LayoutAlgorithm.ForceDirected;
    private readonly LayoutOptions _layoutOptions = new();

    private static readonly string[] Palette =
        ["#3b82f6", "#10b981", "#f59e0b", "#ef4444", "#8b5cf6", "#ec4899", "#06b6d4", "#84cc16"];

    /// <summary>Couleurs attribuées aux liaisons parallèles, pour les distinguer.</summary>
    private static readonly string[] EdgePalette =
        ["#f97316", "#22d3ee", "#a3e635", "#e879f9", "#fbbf24", "#60a5fa"];

    /// <summary>Types proposés dans la liste déroulante de l'inspecteur.</summary>
    private static readonly string[] EdgeTypes =
        ["flow", "dépendance", "retour", "contrainte", "donnée"];

    protected override void OnInitialized()
    {
        _history.Attach(_graph);
        SeedDemoGraph();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Le canvas se construit après le premier rendu de la page : on attend
            // son signal « prêt » pour recadrer la vue.
            if (_canvas is not null)
            {
                _canvas.Ready += OnCanvasReady;

                if (_canvas.IsReady)
                {
                    await OnCanvasReadyAsync();
                }
            }
        }

        // Le menu contextuel doit être mesuré une fois rendu : sa taille réelle
        // est la seule chose qui permette de l'empêcher de déborder du canvas
        // près des bords. À chaque rendu, pas seulement au premier.
        if (!_pendingMenuPlacement || _canvas is null || _contextMenu is null)
        {
            return;
        }

        _pendingMenuPlacement = false;

        try
        {
            await _canvas.PlacePopupAsync(_contextMenuRef, _contextMenu.OffsetX, _contextMenu.OffsetY);
        }
        catch (JSDisconnectedException)
        {
            // Circuit coupé : le menu part avec la page.
        }
    }

    private async Task OnCanvasReadyAsync()
    {
        try
        {
            await FitViewAsync();
            await InvokeAsync(StateHasChanged);
        }
        catch (JSDisconnectedException)
        {
            // Le circuit a été coupé pendant le premier rendu.
        }
    }

    // Abonnement « fire and forget » : le retour est géré par OnCanvasReadyAsync.
    private void OnCanvasReady() => _ = OnCanvasReadyAsync();

    public void Dispose()
    {
        // Les abonnements sont gérés par le composant GraphCanvas.
    }

    private void SeedDemoGraph()
    {
        _graph.BeginBatch();
        try
        {
            var pipeline = new[] { "Collecte", "Nettoyage", "Analyse", "Rapport" };
            var ids = new List<string>();

            for (var i = 0; i < pipeline.Length; i++)
            {
                var node = new GraphNode(
                    id: $"n{i + 1}",
                    label: pipeline[i],
                    x: i * 200 - 300,
                    y: 0,
                    shape: NodeShape.RoundedRectangle,
                    fill: Palette[i % Palette.Length]);

                _graph.AddNode(node);
                ids.Add(node.Id);
            }

            for (var i = 0; i < ids.Count - 1; i++)
            {
                _graph.AddEdge($"e{i + 1}", ids[i], ids[i + 1], "étape");
            }

            var review = new GraphNode("rev", "Revue", 0, 180, NodeShape.Diamond, "#a855f7");
            _graph.AddNode(review);
            _graph.AddEdge("e5", ids[2], "rev", "contrôle");

            var alert = new GraphNode("alert", "Alerte", 250, 190, NodeShape.Hexagon, "#f97316");
            _graph.AddNode(alert);
            _graph.AddEdge("e6", "rev", "alert", "si anomalie");

            SeedSampleData(ids);
        }
        finally
        {
            _graph.EndBatch();
        }
    }

    /// <summary>
    /// Quelques entrées de démonstration, pour que l'éditeur de données ait
    /// immédiatement de quoi montrer : les quatre natures de valeur y figurent.
    /// </summary>
    private void SeedSampleData(IReadOnlyList<string> ids)
    {
        var analyse = _graph.FindNode(ids[2]);

        analyse?.SetDataValue("étape", 3L);
        analyse?.SetDataValue("critique", true);
        analyse?.SetDataValue("seuil", 0.75);
        analyse?.SetDataValue("tags", new List<object?> { "nlp", "v2" });

        _graph.FindNode(ids[3])?.SetDataValue("format", "pdf");

        var step = _graph.FindEdge("e1");
        step?.SetDataValue("débit", 120L);
        step?.SetDataValue("vérifié", false);

        // Une valeur nulle : l'éditeur l'affiche sans champ de saisie.
        _graph.FindEdge("e5")?.SetDataValue("seuil", null);
    }

    // ------------------------------------------------------------- outillage C#

    private void Track()
    {
        _history.Track();
        _log.Clear();
    }

    /// <summary>
    /// Variante de <see cref="Track"/> pour l'éditeur de données : chaque entrée
    /// doit être annulable séparément, mais le journal doit survivre à la saisie.
    /// </summary>
    private void TrackData() => _history.Track();

    /// <summary>
    /// Objet dont le dictionnaire <c>Data</c> est édité. L'inspecteur du dessus
    /// donne la priorité au nœud : on suit le même ordre, sinon les deux panneaux
    /// parleraient d'objets différents.
    /// </summary>
    private GraphElement? DataTarget
    {
        get
        {
            if (_selectedNode is { } node)
            {
                return node;
            }

            return _graph.SelectedEdge;
        }
    }

    /// <summary>Nomme l'objet édité, pour qu'aucune ambiguïté ne subsiste.</summary>
    private string? DataCaption
    {
        get
        {
            if (_selectedNode is { } node)
            {
                var extra = _graph.SelectedNodes.Count > 1
                    ? $" (+{_graph.SelectedNodes.Count - 1} autre(s))"
                    : string.Empty;

                return $"Nœud {node.Id} — {node.Label}{extra}";
            }

            if (_graph.SelectedEdge is { } edge)
            {
                var from = _graph.FindNode(edge.SourceId)?.Label ?? edge.SourceId;
                var to = _graph.FindNode(edge.TargetId)?.Label ?? edge.TargetId;
                return $"Arête {edge.Id} — {from} → {to}";
            }

            return null;
        }
    }

    private void AddNode()
    {
        Track();
        var index = _graph.NodeCount;
        _graph.AddNode(new GraphNode(
            $"n{index + 1}-{DateTime.Now.Ticks % 1000}",
            "Nouveau",
            Random.Shared.Next(-400, 400),
            Random.Shared.Next(-250, 250))
        {
            Shape = (NodeShape)(index % Enum.GetValues<NodeShape>().Length),
            Fill = Palette[index % Palette.Length],
            Stroke = GraphNode.Darken(Palette[index % Palette.Length])
        });

        Log($"Ajout d'un nœud (total : {_graph.NodeCount})");
    }

    /// <summary>Ajoute un nœud au centre de la vue courante (repli si la vue est inconnue).</summary>
private async Task AddNodeAtCenter()
    {
        var center = await CenterOfViewAsync();
        AddNodeAt(center.X, center.Y);
    }

    private async Task<(double X, double Y)> CenterOfViewAsync()
    {
        if (_canvas is null)
        {
            return (0, 0);
        }

        var center = await _canvas.GetCenterAsync();
        return (Math.Round(center.X), Math.Round(center.Y));
    }

    private void AddNodeAt(double x, double y)
    {
        Track();
        var index = _graph.NodeCount;
        var node = new GraphNode(
            $"n{index + 1}-{Random.Shared.Next(100, 999)}",
            $"Nœud {index + 1}",
            Math.Round(x),
            Math.Round(y))
        {
            Shape = (NodeShape)(index % Enum.GetValues<NodeShape>().Length),
            Fill = Palette[index % Palette.Length],
            Stroke = GraphNode.Darken(Palette[index % Palette.Length])
        };

        _graph.AddNode(node);
        _graph.SelectNode(node.Id);
        Log($"Ajout du nœud {node.Label} en ({node.X:0}, {node.Y:0})");
    }

    private void AddLinkedPair()
    {
        Track();
        var x = Random.Shared.Next(-350, 350);
        var a = _graph.AddNode($"A{_graph.NodeCount}", x, 0);
        var b = _graph.AddNode($"B{_graph.NodeCount}", x + 140, 0);
        _graph.AddEdge(a.Id, b.Id, "lien");
        Log("Ajout d'une paire liée");
    }

