            node.Stroke = GraphNode.Darken(color);
        }
    }

    private void UpdatePosition(GraphNode node, string? x, string? y)
        => node.MoveTo(Parse(x, node.X), Parse(y, node.Y));

    private void UpdateRadius(GraphNode node, string? value) => node.Radius = Parse(value, node.Radius);

    private void ToggleLock(GraphNode node, object? value) => node.Locked = value is true;

    private void UpdateEdgeLabel(GraphEdge edge, string value) => edge.Label = value;

    private void UpdateEdgeType(GraphEdge edge, string? value) => edge.Type = value ?? string.Empty;

    private void SetEdgeDirected(GraphEdge edge, bool directed)
    {
